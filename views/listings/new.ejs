<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <br><br>
        <h3>Create a New Listing</h3>
        <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="md-3">
                <label for="title" class="form-label">Title</label>
                <input name="listing[title]" 
                    placeholder="Add a catchy title" 
                    type="text"
                    class="form-control"
                    required
                />
                <div class="valid-feedback">Title looks good!</div>
            </div>
            <div class="md-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" 
                class="form-control"
                required
                ></textarea>
                <div class="invalid-feedback">Please enter a short description</div>
            </div>
            <div class="md-3">
                <label for="image" class="form-label">Upload Listing Image</label>
                <input name="listing[image]" 
                    type="file"
                    class="form-control"
                    required
                >
            </div>
            <div class="row">
                <div class="md-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" 
                        placeholder="1000"
                        
                        class="form-control"
                        required
                    >
                    <!-- if we write any invalid in price it will show please enter a valid price  -->
                    <div class="invalid-feedback">PLease enter a valid price</div>
                </div>

                <div class="md-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" 
                        placeholder="India" 
                        type="text"
                        class="form-control"
                        required
                    >
                    <div class="invalid-feedback">Country should be valid</div>
                </div>
            </div>
    
            <div class="md-3">
                <label for="location" class="form-label">Location</label>
                <input name="listing[location]" 
                    placeholder="Shivamogga, Karnataka" 
                    type="text"
                    class="form-control"
                    required
                >
                <div class="invalid-feedback">location should be valid</div>
            </div>
            
            <button class="btn btn-dark add-btn mt-3">add</button>
            
        </form>
    </div>
</div>
